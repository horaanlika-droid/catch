# ── Нужно заполнить на bothost.ru — только эти две переменные ─────────────
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_IDS=111111111,222222222

# ── Всё остальное настривается автоматически (можно не трогать) ───────────
# PORT — bothost.ru отдаёт сам; приложение слушает 0.0.0.0:$PORT
# PUBLIC_URL — авто: https://bot-<BOT_ID>-<USER_ID>-user.bothost.tech
#              (или из переменной DOMAIN, которую даёт платформа)
# BOT_MODE=auto          # auto | webhook | polling
# DATA_DIR=              # авто: /app/data на bothost (персистентно), иначе ./data
